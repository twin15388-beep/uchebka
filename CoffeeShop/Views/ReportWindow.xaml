<Window x:Class="CoffeeShop.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кофейня «Зёрнышко» — отчёты"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#6F4E37">
            <Grid Margin="24,0">
                <TextBlock Text="Отчёты" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="выручка, продажи и популярные позиции"
                           FontSize="12" Foreground="#F3E9DF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White"
                BorderBrush="#E7D9C6" BorderThickness="0,1,0,1"
                Padding="24,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Вид отчёта:" FontSize="14"
                           Foreground="#5D4037" VerticalAlignment="Center" />
                <ComboBox x:Name="ReportTypeBox" Width="240" Height="34"
                          Margin="8,0,0,0" VerticalContentAlignment="Center"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Выручка за период" />
                    <ComboBoxItem Content="Продажи по категориям" />
                    <ComboBoxItem Content="Популярные позиции" />
                </ComboBox>
                <TextBlock Text="Период с:" FontSize="14" Foreground="#5D4037"
                           Margin="28,0,8,0" VerticalAlignment="Center" />
                <DatePicker x:Name="FromPicker" Width="150" Height="34" />
                <TextBlock Text="по:" FontSize="14" Foreground="#5D4037"
                           Margin="12,0,8,0" VerticalAlignment="Center" />
                <DatePicker x:Name="ToPicker" Width="150" Height="34" />
                <Button Content="Сформировать" Height="34" Width="150"
                        Margin="24,0,0,0" Click="Generate_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="#E7D9C6" BorderThickness="1"
                Margin="24,16,24,20" Padding="10">
            <DataGrid x:Name="ReportGrid" AutoGenerateColumns="True"
                      IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0" FontSize="13" RowHeight="30" />
        </Border>
    </Grid>
</Window>
