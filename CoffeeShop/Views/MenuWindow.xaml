<Window x:Class="CoffeeShop.Views.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кофейня «Зёрнышко» — меню"
        Height="620" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#6F4E37">
            <Grid Margin="24,0">
                <TextBlock Text="Меню" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="ведение позиций, категорий и цен"
                           FontSize="12" Foreground="#F3E9DF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E7D9C6" BorderThickness="1" Padding="10">
                <ListView x:Name="MenuList"
                          SelectionChanged="MenuList_SelectionChanged"
                          BorderThickness="0" FontSize="14">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Наименование"
                                            Width="220"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Категория"
                                            Width="150"
                                            DisplayMemberBinding="{Binding Category}" />
                            <GridViewColumn Header="Цена, ₽"
                                            Width="120"
                                            DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2}}" />
                            <GridViewColumn Header="Доступна"
                                            Width="110"
                                            DisplayMemberBinding="{Binding Availability}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="#E7D9C6" BorderThickness="1" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Позиция меню" FontSize="16"
                               FontWeight="Bold" Foreground="#3E2723"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Наименование" FontSize="12"
                               Foreground="#5D4037" />
                    <TextBox x:Name="NameBox" Height="34" FontSize="14"
                             Margin="0,4,0,12" VerticalContentAlignment="Center" />

                    <TextBlock Text="Категория" FontSize="12"
                               Foreground="#5D4037" />
                    <ComboBox x:Name="CategoryBox" Height="34" FontSize="14"
                              Margin="0,4,0,12" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Кофе" IsSelected="True" />
                        <ComboBoxItem Content="Чай" />
                        <ComboBoxItem Content="Десерты" />
                        <ComboBoxItem Content="Выпечка" />
                    </ComboBox>

                    <TextBlock Text="Цена, ₽" FontSize="12"
                               Foreground="#5D4037" />
                    <TextBox x:Name="PriceBox" Height="34" FontSize="14"
                             Margin="0,4,0,12" VerticalContentAlignment="Center" />

                    <CheckBox x:Name="AvailableCheck" Content="Доступна для продажи"
                              FontSize="13" Margin="0,0,0,18" IsChecked="True" />

                    <Button Content="Добавить" Height="38" Click="Add_Click" />
                    <Button Content="Сохранить" Height="38" Margin="0,8,0,0"
                            Click="Save_Click" />
                    <Button Content="Удалить" Height="38" Margin="0,8,0,0"
                            Background="#E7D9C6" BorderBrush="#E7D9C6"
                            Foreground="#3E2723" Click="Delete_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
