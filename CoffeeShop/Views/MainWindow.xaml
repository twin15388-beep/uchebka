<Window x:Class="CoffeeShop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кофейня «Зёрнышко» — главное меню"
        Height="580" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border Background="#6F4E37">
            <Grid Margin="28,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Кофейня «Зёрнышко»"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="информационная система автоматизации работы кофейни"
                               FontSize="12" Foreground="#F3E9DF" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserNameText" FontSize="14"
                               Foreground="White" HorizontalAlignment="Right" />
                    <TextBlock x:Name="UserRoleText" FontSize="12"
                               Foreground="#F3E9DF" HorizontalAlignment="Right"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="2" Rows="3" Margin="28,24,28,8">
            <Button Click="Orders_Click" Margin="10,8" Height="86">
                <StackPanel>
                    <TextBlock Text="Заказы" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="оформление и оплата" FontSize="11"
                               Opacity="0.85" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="MenuButton" Click="Menu_Click" Margin="10,8" Height="86">
                <StackPanel>
                    <TextBlock Text="Меню" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="позиции, категории и цены" FontSize="11"
                               Opacity="0.85" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button Click="Tables_Click" Margin="10,8" Height="86">
                <StackPanel>
                    <TextBlock Text="Столики" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="зал и посадка гостей" FontSize="11"
                               Opacity="0.85" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button Click="Shifts_Click" Margin="10,8" Height="86">
                <StackPanel>
                    <TextBlock Text="Смены" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="открытие, закрытие, выручка" FontSize="11"
                               Opacity="0.85" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="ReportsButton" Click="Reports_Click" Margin="10,8" Height="86">
                <StackPanel>
                    <TextBlock Text="Отчёты" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="выручка и популярные позиции" FontSize="11"
                               Opacity="0.85" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Button>
            <Button Click="Exit_Click" Margin="10,8" Height="86"
                    Background="#E7D9C6" BorderBrush="#E7D9C6"
                    Foreground="#3E2723">
                <StackPanel>
                    <TextBlock Text="Выход" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="завершить работу" FontSize="11"
                               Opacity="0.85" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <Border Grid.Row="2" Background="#EFEBE9">
            <Grid Margin="28,0">
                <TextBlock x:Name="StatusText" Text="Смена не открыта"
                           FontSize="12" Foreground="#5D4037"
                           VerticalAlignment="Center" />
                <TextBlock Text="Кофейня «Зёрнышко» · версия 1.0"
                           FontSize="12" Foreground="#8D6E63"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
