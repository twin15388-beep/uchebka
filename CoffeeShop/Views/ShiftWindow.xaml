<Window x:Class="CoffeeShop.Views.ShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кофейня «Зёрнышко» — смены"
        Height="540" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#6F4E37">
            <Grid Margin="24,0">
                <TextBlock Text="Смены" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="открытие, закрытие и выручка"
                           FontSize="12" Foreground="#F3E9DF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E7D9C6" BorderThickness="1" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ShiftStatusText"
                                   Text="Смена не открыта" FontSize="18"
                                   FontWeight="Bold" Foreground="#3E2723" />
                        <TextBlock x:Name="ShiftInfoText"
                                   Text="Откройте смену перед началом работы"
                                   FontSize="13" Foreground="#5D4037"
                                   Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Выручка: " FontSize="14"
                                       Foreground="#5D4037" />
                            <TextBlock x:Name="RevenueText" Text="0,00 ₽"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#6F4E37" />
                            <TextBlock Text="     Чеков: " FontSize="14"
                                       Foreground="#5D4037" />
                            <TextBlock x:Name="ChecksText" Text="0"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#6F4E37" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="OpenShiftButton" Content="Открыть смену"
                                Width="170" Height="38" Click="OpenShift_Click" />
                        <Button x:Name="CloseShiftButton" Content="Закрыть смену"
                                Width="170" Height="38" Margin="0,10,0,0"
                                Background="#E7D9C6" BorderBrush="#E7D9C6"
                                Foreground="#3E2723" Click="CloseShift_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="8"
                    BorderBrush="#E7D9C6" BorderThickness="1"
                    Padding="10" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Закрытые смены" FontSize="14"
                               FontWeight="Bold" Foreground="#3E2723"
                               Margin="0,0,0,8" />
                    <ListView Grid.Row="1" x:Name="ShiftList" FontSize="13">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Дата открытия"
                                                Width="190"
                                                DisplayMemberBinding="{Binding OpenedAt}" />
                                <GridViewColumn Header="Бариста"
                                                Width="240"
                                                DisplayMemberBinding="{Binding UserName}" />
                                <GridViewColumn Header="Выручка, ₽"
                                                Width="150"
                                                DisplayMemberBinding="{Binding Revenue}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
