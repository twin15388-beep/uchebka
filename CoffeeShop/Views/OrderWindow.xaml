<Window x:Class="CoffeeShop.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кофейня «Зёрнышко» — оформление заказа"
        Height="720" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#FAF6F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border Background="#6F4E37">
            <Grid Margin="24,0">
                <TextBlock Text="Оформление заказа" FontSize="20"
                           FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ShiftInfoText" FontSize="12"
                           Foreground="#F3E9DF" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White"
                BorderBrush="#E7D9C6" BorderThickness="0,1,0,1" Padding="24,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Столик:" FontSize="14" Foreground="#5D4037"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="TableBox" Width="210" Height="34"
                          Margin="8,0,0,0" VerticalContentAlignment="Center" />
                <TextBlock Text="Тип заказа:" FontSize="14" Foreground="#5D4037"
                           Margin="28,0,8,0" VerticalAlignment="Center" />
                <RadioButton x:Name="HereRadio" Content="На месте"
                             IsChecked="True" FontSize="14"
                             VerticalContentAlignment="Center" />
                <RadioButton x:Name="TakeawayRadio" Content="С собой"
                             FontSize="14" Margin="16,0,0,0"
                             VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="236" />
                </Grid.RowDefinitions>

                <Border Background="White" CornerRadius="8"
                        BorderBrush="#E7D9C6" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Меню" FontSize="14" FontWeight="Bold"
                                   Foreground="#3E2723" Margin="0,0,0,8" />
                        <ListView Grid.Row="1" x:Name="MenuList" FontSize="13">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Наименование"
                                                    Width="230"
                                                    DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Цена, ₽"
                                                    Width="110"
                                                    DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2}}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="White" CornerRadius="8"
                        BorderBrush="#E7D9C6" BorderThickness="1"
                        Padding="16,12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Модификаторы" FontSize="14"
                                   FontWeight="Bold" Foreground="#3E2723"
                                   Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Размер:" FontSize="13"
                                       Foreground="#5D4037"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="SizeBox" Grid.Column="1"
                                      Height="32" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Стандарт" IsSelected="True" />
                                <ComboBoxItem Content="Большой (+40 ₽)" />
                            </ComboBox>

                            <TextBlock Text="Молоко:" Grid.Column="2" FontSize="13"
                                       Foreground="#5D4037"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="MilkBox" Grid.Column="3"
                                      Height="32" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Обычное" IsSelected="True" />
                                <ComboBoxItem Content="Овсяное (+30 ₽)" />
                                <ComboBoxItem Content="Кокосовое (+30 ₽)" />
                            </ComboBox>

                            <TextBlock Text="Сироп:" Grid.Row="1" FontSize="13"
                                       Foreground="#5D4037"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="SyrupBox" Grid.Row="1"
                                      Grid.Column="1" Height="32"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Без сиропа" IsSelected="True" />
                                <ComboBoxItem Content="Карамель (+20 ₽)" />
                                <ComboBoxItem Content="Ваниль (+20 ₽)" />
                            </ComboBox>

                            <TextBlock Text="Количество:" Grid.Row="1"
                                       Grid.Column="2" FontSize="13"
                                       Foreground="#5D4037"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="QtyBox" Grid.Row="1" Grid.Column="3"
                                     Height="32" Width="70" FontSize="14"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     Text="1" />

                            <CheckBox x:Name="CreamCheck" Grid.Row="2"
                                      Grid.ColumnSpan="2" FontSize="13"
                                      Content="Взбитые сливки (+25 ₽)"
                                      VerticalAlignment="Center" />
                            <Button Content="Добавить позицию" Grid.Row="2"
                                    Grid.Column="2" Grid.ColumnSpan="2"
                                    Height="34" HorizontalAlignment="Right"
                                    Width="170" Click="AddItem_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="#E7D9C6" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Состав заказа" FontSize="14"
                               FontWeight="Bold" Foreground="#3E2723"
                               Margin="0,0,0,8" />
                    <DataGrid Grid.Row="1" x:Name="OrderGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0" FontSize="13" RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Позиция"
                                                Binding="{Binding Name}"
                                                Width="180" />
                            <DataGridTextColumn Header="Модификаторы"
                                                Binding="{Binding Modifiers}"
                                                Width="190" />
                            <DataGridTextColumn Header="Кол-во"
                                                Binding="{Binding Quantity}"
                                                Width="60" />
                            <DataGridTextColumn Header="Сумма, ₽"
                                                Binding="{Binding Sum, StringFormat={}{0:N2}}"
                                                Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#EFEBE9" Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Итого:" FontSize="16" FontWeight="Bold"
                               Foreground="#3E2723" />
                    <TextBlock x:Name="TotalText" Text="0,00 ₽" FontSize="18"
                               FontWeight="Bold" Foreground="#6F4E37"
                               Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Удалить позицию" Height="36"
                            Background="#E7D9C6" BorderBrush="#E7D9C6"
                            Foreground="#3E2723" Click="DeleteItem_Click" />
                    <Button Content="Сохранить заказ" Height="36"
                            Margin="8,0,0,0" Click="SaveOrder_Click" />
                    <Button Content="Оплатить и закрыть чек" Height="36"
                            Margin="8,0,0,0" Click="PayOrder_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
