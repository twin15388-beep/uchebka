<Window x:Class="CoffeeShop.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кофейня «Зёрнышко» — авторизация"
        Height="380" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAF6F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#6F4E37">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Кофейня «Зёрнышко»"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="информационная система автоматизации работы кофейни"
                           FontSize="12" Foreground="#F3E9DF"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="#E7D9C6" BorderThickness="1"
                Margin="32,28,32,28" Padding="28,20">
            <StackPanel>
                <TextBlock Text="Авторизация"
                           FontSize="19" FontWeight="Bold"
                           Foreground="#3E2723"
                           HorizontalAlignment="Center" Margin="0,0,0,18" />

                <TextBlock Text="Логин" FontSize="13" Foreground="#5D4037" />
                <TextBox x:Name="LoginBox" Height="36" FontSize="14"
                         Margin="0,4,0,12"
                         VerticalContentAlignment="Center"
                         BorderBrush="#D7CCC8" BorderThickness="1" />

                <TextBlock Text="Пароль" FontSize="13" Foreground="#5D4037" />
                <PasswordBox x:Name="PasswordBox" Height="36" FontSize="14"
                             Margin="0,4,0,20"
                             VerticalContentAlignment="Center"
                             BorderBrush="#D7CCC8" BorderThickness="1" />

                <Button Content="Войти" Height="42" FontSize="15"
                        Click="Login_Click" />

                <Button Content="Выход" Height="38" Margin="0,10,0,0"
                        Background="#E7D9C6" BorderBrush="#E7D9C6"
                        Foreground="#3E2723" Click="Exit_Click" />

                <TextBlock Text="Введите логин и пароль, выданные администратором"
                           FontSize="11" Foreground="#8D6E63"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
